// Time Complexity: O(nlogn)
// Space Complexity: O(n)

// Sort the intervals by start time
// Add the first intervals end time to a min heap and for every subsequent interval check if it overlaps with the interval end time at top of heap
// If it overlaps add the new end time to the heap else update the peek value to the larger end time
// Return the size of the heap to get the total number of meeting rooms required

class Solution {
    public int minMeetingRooms(int[][] intervals) {
        // sort intervals by start time
        Arrays.sort(intervals, (a,b) -> Integer.compare(a[0], b[0]));
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        pq.add(intervals[0][1]);

        for(int i = 1; i < intervals.length; i++) {
            // intervals overlap
            if(intervals[i][0] < pq.peek()) 
                pq.add(intervals[i][1]);
                
            // intervals do not overlap
            else { 
                if(intervals[i][1] > pq.peek()) {
                    pq.poll();
                    pq.add(intervals[i][1]);
                }
            }
        }
        return pq.size();
    }
}